+
+[[nodiscard]] bool ReadKeyInfo(
+		const QString &basePath,
+		const QString &dataName,
+		ImportedKeyInfo *result) {
+	auto keyData = Storage::details::FileReadDescriptor();
+	if (!Storage::details::ReadFile(keyData, u"key_"_q + dataName, basePath)) {
+		return false;
+	}
+
+	auto salt = QByteArray();
+	auto keyEncrypted = QByteArray();
+	auto infoEncrypted = QByteArray();
+	keyData.stream >> salt >> keyEncrypted >> infoEncrypted;
+	if (!Storage::details::CheckStreamStatus(keyData.stream)
+		|| salt.size() != kLocalEncryptSaltSize) {
+		return false;
+	}
+
+	const auto passcodeKey = Storage::details::CreateLocalKey(
+		QByteArray(),
+		salt);
+	auto keyInner = Storage::details::EncryptedDescriptor();
+	if (!Storage::details::DecryptLocal(keyInner, keyEncrypted, passcodeKey)) {
+		return false;
+	}
+	const auto key = Serialize::read<MTP::AuthKey::Data>(keyInner.stream);
+	if (keyInner.stream.status() != QDataStream::Ok
+		|| !keyInner.stream.atEnd()) {
+		return false;
+	}
+	const auto localKey = std::make_shared<MTP::AuthKey>(key);
+
+	auto info = Storage::details::EncryptedDescriptor();
+	if (!Storage::details::DecryptLocal(info, infoEncrypted, localKey)) {
+		return false;
+	}
+	auto count = qint32();
+	info.stream >> count;
+	if (!Storage::details::CheckStreamStatus(info.stream)
+		|| count <= 0
+		|| count > 1000000) {
+		return false;
+	}
+
+	auto indices = std::vector<int>();
+	indices.reserve(count);
+	for (auto i = 0; i != count; ++i) {
+		auto index = qint32();
+		info.stream >> index;
+		if (!Storage::details::CheckStreamStatus(info.stream)) {
+			return false;
+		}
+		if (index >= 0 && index < ::Main::Domain::kPremiumMaxAccounts) {
+			indices.push_back(index);
+		}
+	}
+	if (indices.empty()) {
+		return false;
+	}
+
+	result->localKey = std::move(localKey);
+	result->accountIndices = std::move(indices);
+	return true;
+}
+
+[[nodiscard]] bool ReadSelfSerializedFromMap(
+		const QString &accountBasePath,
+		const std::shared_ptr<MTP::AuthKey> &localKey,
+		QByteArray *selfSerialized,
+		int *mapVersion) {
+	auto mapData = Storage::details::FileReadDescriptor();
+	if (!Storage::details::ReadFile(mapData, u"map"_q, accountBasePath)) {
+		return false;
+	}
+
+	auto legacySalt = QByteArray();
+	auto legacyKeyEncrypted = QByteArray();
+	auto mapEncrypted = QByteArray();
+	mapData.stream >> legacySalt >> legacyKeyEncrypted >> mapEncrypted;
+	if (!Storage::details::CheckStreamStatus(mapData.stream)) {
+		return false;
+	}
+
+	auto map = Storage::details::EncryptedDescriptor();
+	if (!Storage::details::DecryptLocal(map, mapEncrypted, localKey)) {
+		return false;
+	}
+
+	while (!map.stream.atEnd()) {
+		auto rawKeyType = quint32();
+		map.stream >> rawKeyType;
+		if (!Storage::details::CheckStreamStatus(map.stream)) {
+			return false;
+		}
+		const auto keyType = MapKeyType(rawKeyType);
+		switch (keyType) {
+		case MapKeyType::SelfSerialized: {
+			map.stream >> *selfSerialized;
+			if (!Storage::details::CheckStreamStatus(map.stream)) {
+				return false;
+			}
+			*mapVersion = mapData.version;
+			return !selfSerialized->isEmpty();
+		}
+		case MapKeyType::Draft:
+		case MapKeyType::DraftPosition:
+		case MapKeyType::BotStorages: {
+			auto count = quint32();
+			map.stream >> count;
+			for (auto i = 0U; i != count; ++i) {
+				auto key = quint64();
+				auto peerIdSerialized = quint64();
+				map.stream >> key >> peerIdSerialized;
+			}
+		} break;
+		case MapKeyType::LegacyImages:
+		case MapKeyType::LegacyStickerImages:
+		case MapKeyType::LegacyAudios: {
+			auto count = quint32();
+			map.stream >> count;
+			for (auto i = 0U; i != count; ++i) {
+				auto key = quint64();
+				auto first = quint64();
+				auto second = quint64();
+				auto size = qint32();
+				map.stream >> key >> first >> second >> size;
+			}
+		} break;
+		case MapKeyType::WebviewTokens: {
+			auto bots = QByteArray();
+			auto other = QByteArray();
+			map.stream >> bots >> other;
+		} break;
+		case MapKeyType::Locations:
+		case MapKeyType::RecentStickersOld:
+		case MapKeyType::BackgroundOldOld:
+		case MapKeyType::UserSettings:
+		case MapKeyType::RecentHashtagsAndBots:
+		case MapKeyType::StickersOld:
+		case MapKeyType::SavedPeersOld:
+		case MapKeyType::ReportSpamStatusesOld:
+		case MapKeyType::SavedGifsOld:
+		case MapKeyType::SavedGifs:
+		case MapKeyType::StickersKeys:
+		case MapKeyType::TrustedPeers:
+		case MapKeyType::FavedStickers:
+		case MapKeyType::ExportSettings:
+		case MapKeyType::BackgroundOld:
+		case MapKeyType::MasksKeys:
+		case MapKeyType::CustomEmojiKeys:
+		case MapKeyType::SearchSuggestions:
+		case MapKeyType::RoundPlaceholder:
+		case MapKeyType::InlineBotsDownloads:
+		case MapKeyType::MediaLastPlaybackPositions:
+		case MapKeyType::Prefs: {
+			auto value = quint64();
+			map.stream >> value;
+		} break;
+		default:
+			return false;
+		}
+		if (!Storage::details::CheckStreamStatus(map.stream)) {
+			return false;
+		}
+	}
+	return false;
+}
+
+[[nodiscard]] bool ReadMtpAuthorization(
+		const QString &basePath,
+		const QString &dataName,
+		int index,
+		const std::shared_ptr<MTP::AuthKey> &localKey,
+		QByteArray *mtpAuthorization) {
+	const auto accountDataName = ComposeAccountDataName(dataName, index);
+	const auto dataNameKey = ComputeDataNameKey(accountDataName);
+	auto mtp = Storage::details::FileReadDescriptor();
+	if (!Storage::details::ReadEncryptedFile(
+			mtp,
+			dataNameKey,
+			basePath,
+			localKey)) {
+		return false;
+	}
+
+	auto context = Storage::details::ReadSettingsContext();
+	while (!mtp.stream.atEnd()) {
+		auto blockId = quint32();
+		mtp.stream >> blockId;
+		if (!Storage::details::CheckStreamStatus(mtp.stream)) {
+			return false;
+		}
+		if (!Storage::details::ReadSetting(
+				blockId,
+				mtp.stream,
+				mtp.version,
+				context)) {
+			return false;
+		}
+	}
+	if (context.mtpAuthorization.isEmpty()) {
+		return false;
+	}
+	*mtpAuthorization = std::move(context.mtpAuthorization);
+	return true;
+}
+
+[[nodiscard]] uint64 ParseUserIdFromAuthorization(
+		const QByteArray &authorization) {
+	auto stream = QDataStream(authorization);
+	stream.setVersion(QDataStream::Qt_5_1);
+
+	const auto legacyUserId = Serialize::read<qint32>(stream);
+	const auto legacyMainDcId = Serialize::read<qint32>(stream);
+	auto userId = quint64(0);
+	if (((uint64(legacyUserId) << 32) | uint64(legacyMainDcId))
+		== ~uint64(0)) {
+		userId = Serialize::read<quint64>(stream);
+	} else {
+		userId = uint64(uint32(legacyUserId));
+	}
+	return (stream.status() == QDataStream::Ok) ? userId : 0;
+}
+
+[[nodiscard]] std::vector<ImportedTdataAccount> ReadImportableTdataAccounts(
+		const QString &basePath) {
+	auto result = std::vector<ImportedTdataAccount>();
+	const auto keyFiles = QDir(basePath).entryList(
+		{ u"key_*"_q },
+		QDir::Files,
+		QDir::Name);
+	for (const auto &keyFile : keyFiles) {
+		if (!keyFile.startsWith(u"key_"_q) || keyFile.size() <= 4) {
+			continue;
+		}
+		const auto dataName = keyFile.mid(4);
+		auto keyInfo = ImportedKeyInfo();
+		if (!ReadKeyInfo(basePath, dataName, &keyInfo)) {
+			continue;
+		}
+		for (const auto index : keyInfo.accountIndices) {
+			const auto accountBasePath = AccountBasePath(basePath, dataName, index);
+			if (!QFileInfo(accountBasePath).isDir()) {
+				continue;
+			}
+			auto selfSerialized = QByteArray();
+			auto selfStreamVersion = 0;
+			if (!ReadSelfSerializedFromMap(
+					accountBasePath,
+					keyInfo.localKey,
+					&selfSerialized,
+					&selfStreamVersion)) {
+				continue;
+			}
+			auto mtpAuthorization = QByteArray();
+			if (!ReadMtpAuthorization(
+					basePath,
+					dataName,
+					index,
+					keyInfo.localKey,
+					&mtpAuthorization)) {
+				continue;
+			}
+			result.push_back(ImportedTdataAccount{
+				.dataName = dataName,
+				.index = index,
+				.userId = ParseUserIdFromAuthorization(mtpAuthorization),
+				.mtpAuthorization = std::move(mtpAuthorization),
+				.selfSerialized = std::move(selfSerialized),
+				.selfStreamVersion = selfStreamVersion,
+			});
+		}
+	}
+	ranges::sort(result, ranges::less(), [](const ImportedTdataAccount &value) {
+		return std::make_pair(value.dataName, value.index);
+	});
+	return result;
+}
+
+[[nodiscard]] QString ImportedAccountTitle(const ImportedTdataAccount &account) {
+	const auto title = account.userId
+		? u"User %1"_q.arg(account.userId)
+		: u"Account %1"_q.arg(account.index + 1);
+	return (account.dataName == u"data"_q)
+		? title
+		: u"[%1] %2"_q.arg(account.dataName, title);
+}
 
