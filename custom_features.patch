+[[nodiscard]] QString AccountBasePath(
+		const QString &basePath,
+		const QString &dataName,
+		int index) {
+	const auto accountDataName = ComposeAccountDataName(dataName, index);
+	const auto key = ComputeDataNameKey(accountDataName);
+	return basePath + Storage::details::ToFilePart(key) + '/';
+}
