+
+void AccountModeButton::paintEvent(QPaintEvent *e) {
+	auto p = Painter(this);
+	p.setRenderHint(QPainter::Antialiasing, true);
+
+	const auto bg = _active
+		? st::windowBgActive
+		: isOver()
+		? st::menuBgOver
+		: st::windowBg;
+	const auto fg = _active ? st::windowBoldFg : st::windowSubTextFg;
+	const auto size = st::mainMenuAccountControlSize;
+	const auto line = st::mainMenuAccountControlLine;
+
+	p.setPen(Qt::NoPen);
+	p.setBrush(bg);
+	p.drawEllipse(rect());
+
+	auto pen = fg->p;
+	pen.setWidth(line);
+	pen.setCapStyle(Qt::RoundCap);
+	pen.setJoinStyle(Qt::RoundJoin);
+	p.setPen(pen);
+	p.setBrush(Qt::NoBrush);
+
+	if (_kind == Kind::Pause) {
+		const auto radius = (size - line * 4) / 2.0;
+		const auto center = QPointF(size / 2.0, size / 2.0);
+		p.drawArc(
+			QRectF(
+				center.x() - radius,
+				center.y() - radius,
+				radius * 2,
+				radius * 2),
+			35 * 16,
+			290 * 16);
+		p.drawLine(
+			QPointF(center.x(), center.y() - radius - 0.5),
+			QPointF(center.x(), center.y() - radius * 0.2));
+	} else {
+		const auto left = size * 0.25;
+		const auto right = size * 0.75;
+		const auto top = size * 0.3;
+		const auto bottom = size * 0.72;
+		const auto center = size * 0.52;
+		auto bell = QPainterPath();
+		bell.moveTo(left, center);
+		bell.cubicTo(left, top, right, top, right, center);
+		bell.lineTo(right - line, bottom);
+		bell.lineTo(left + line, bottom);
+		bell.closeSubpath();
+		p.drawPath(bell);
+		p.drawLine(
+			QPointF(size * 0.42, bottom),
+			QPointF(size * 0.58, bottom));
+		if (_active) {
+			p.drawLine(
+				QPointF(size * 0.2, size * 0.8),
+				QPointF(size * 0.8, size * 0.2));
+		}
+	}
+}
