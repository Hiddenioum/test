+bool Settings::accountPausedForUi(uint64 sessionUniqueId) const {
+	const auto i = _accountsUiModes.find(sessionUniqueId);
+	return (i != end(_accountsUiModes))
+		&& ((i->second & kAccountUiModePaused) != 0);
+}
+
+void Settings::setAccountPausedForUi(uint64 sessionUniqueId, bool paused) {
+	if (!sessionUniqueId) {
+		return;
+	}
+	auto flags = uchar(0);
+	if (const auto i = _accountsUiModes.find(sessionUniqueId);
+		i != end(_accountsUiModes)) {
+		flags = i->second;
+	}
+	const auto now = paused
+		? (flags | kAccountUiModePaused)
+		: (flags & ~kAccountUiModePaused);
+	if (now) {
+		_accountsUiModes[sessionUniqueId] = now;
+	} else {
+		_accountsUiModes.erase(sessionUniqueId);
+	}
+}
+
+bool Settings::accountSilentForUi(uint64 sessionUniqueId) const {
+	const auto i = _accountsUiModes.find(sessionUniqueId);
+	return (i != end(_accountsUiModes))
+		&& ((i->second & kAccountUiModeSilent) != 0);
+}
+
+void Settings::setAccountSilentForUi(uint64 sessionUniqueId, bool silent) {
+	if (!sessionUniqueId) {
+		return;
+	}
+	auto flags = uchar(0);
+	if (const auto i = _accountsUiModes.find(sessionUniqueId);
+		i != end(_accountsUiModes)) {
+		flags = i->second;
+	}
+	const auto now = silent
+		? (flags | kAccountUiModeSilent)
+		: (flags & ~kAccountUiModeSilent);
+	if (now) {
+		_accountsUiModes[sessionUniqueId] = now;
+	} else {
+		_accountsUiModes.erase(sessionUniqueId);
+	}
+}
+
+void Settings::clearAccountUiMode(uint64 sessionUniqueId) {
+	if (!sessionUniqueId) {
+		return;
+	}
+	_accountsUiModes.erase(sessionUniqueId);
+}
