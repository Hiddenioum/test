+
+void AccountsList::chooseImportFolder() {
+	FileDialog::GetFolder(
+		Core::App().getFileDialogParent(),
+		u"Select Telegram data folder"_q,
+		QDir::homePath(),
+		crl::guard(_outer, [=](QString &&result) {
+			const auto basePath = NormalizeTdataBasePath(std::move(result));
+			if (basePath.isEmpty()) {
+				_controller->show(Ui::MakeInformBox(
+					u"Selected folder does not contain Telegram Desktop data."_q));
+				return;
+			}
+
+			auto imported = ReadImportableTdataAccounts(basePath);
+			if (imported.empty()) {
+				_controller->show(Ui::MakeInformBox(
+					u"No importable sessions found in this folder."_q));
+				return;
+			}
+
+			_controller->show(Box(
+				[=, imported = std::move(imported)](
+						not_null<Ui::GenericBox*> box) mutable {
+					box->setTitle(rpl::single(u"Import tdata sessions"_q));
+					auto checks = std::vector<QPointer<Ui::Checkbox>>();
+					checks.reserve(imported.size());
+					for (const auto &entry : imported) {
+						const auto checkbox = box->addRow(
+							object_ptr<Ui::Checkbox>(
+								box,
+								ImportedAccountTitle(entry),
+								true,
+								st::defaultBoxCheckbox));
+						checks.push_back(checkbox);
+					}
+
+					box->addButton(tr::lng_contact_add(), [=] {
+						auto selected = std::vector<int>();
+						selected.reserve(imported.size());
+						for (auto i = 0; i != checks.size(); ++i) {
+							if (checks[i] && checks[i]->checked()) {
+								selected.push_back(i);
+							}
+						}
+						if (selected.empty()) {
+							box->closeBox();
+							return;
+						}
+
+						auto &domain = _controller->session().domain();
+						auto first = (::Main::Account*)nullptr;
+						auto importedCount = 0;
+						for (const auto index : selected) {
+							const auto &entry = imported[index];
+							auto duplicate = false;
+							for (const auto &[accountIndex, account]
+								: domain.accounts()) {
+								if (const auto session = account->maybeSession()) {
+									if (entry.userId
+										&& session->userId().bare == entry.userId) {
+										duplicate = true;
+										break;
+									}
+								}
+							}
+							if (duplicate) {
+								continue;
+							}
+							if (domain.accounts().size()
+								>= ::Main::Domain::kPremiumMaxAccounts) {
+								break;
+							}
+							auto selfSerialized = entry.selfSerialized;
+							const auto added = domain.addFromStorage(
+								MTP::Environment::Production,
+								entry.mtpAuthorization,
+								std::move(selfSerialized),
+								entry.selfStreamVersion);
+							if (!first) {
+								first = added;
+							}
+							++importedCount;
+						}
+						box->closeBox();
+						if (!first) {
+							_controller->show(Ui::MakeInformBox(
+								u"No new accounts were imported."_q));
+							return;
+						}
+
+						_controller->session().domain().maybeActivate(
+							not_null{ first });
+						_controller->show(Ui::MakeInformBox(
+							u"Imported %1 account(s)."_q.arg(importedCount)));
+					});
+					box->addButton(tr::lng_cancel(), [=] {
+						box->closeBox();
+					});
+				}),
+				Ui::LayerOption::CloseOther);
+		}));
+}
 
