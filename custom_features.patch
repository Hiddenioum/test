+[[nodiscard]] QString EnsureSlash(QString path) {
+	if (!path.endsWith('/')) {
+		path += '/';
+	}
+	return path;
+}
+
+[[nodiscard]] bool LooksLikeTdata(const QString &path) {
+	if (path.isEmpty()) {
+		return false;
+	}
+	return !QDir(path).entryList({ u"key_*"_q }, QDir::Files).isEmpty();
+}
+
+[[nodiscard]] QString NormalizeTdataBasePath(QString path) {
+	path = EnsureSlash(std::move(path));
+	if (LooksLikeTdata(path)) {
+		return path;
+	}
+	const auto nested = path + u"tdata/"_q;
+	return LooksLikeTdata(nested) ? nested : QString();
+}
