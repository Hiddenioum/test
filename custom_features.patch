+void Filler::addGhostModeToggle() {
+	if (!_peer) {
+		return;
+	}
+	const auto history = &_peer->owner().history(_peer);
+	const auto isGhost = history->ghostModeActive();
+	const auto text = isGhost
+		? QString(u"Disable Ghost Mode"_q)
+		: QString(u"View in Ghost Mode 👻"_q);
+	const auto peer = _peer;
+	const auto controller = _controller;
+	_addAction(text, [=] {
+		history->setGhostModeActive(!isGhost);
+		controller->showPeerHistory(peer);
+	}, &st::menuIconShowInChat);
+}
